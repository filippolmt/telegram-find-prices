# Telegram API credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Bot token (from @BotFather)
BOT_TOKEN=

# Telegram account for the user client
USERNAME=
PHONE_NUMBER=

# Comma-separated numeric user IDs allowed to use the bot (empty = nobody, unless ALLOW_ALL_USERS=true)
# Get your ID from @userinfobot
ALLOWED_USERS=
# Set to true ONLY to let any Telegram user drive your account (used when ALLOWED_USERS is empty)
ALLOW_ALL_USERS=

# Telethon StringSession for user client (generated with: make gen-session)
# Avoids the need for interactive authentication and session files
# CLIENT_SESSION_STRING=

# Timezone for daily summary (default: UTC)
TIMEZONE=Europe/Rome

# Hour of the day for daily summary, 0-23 (default: 21)
DAILY_SUMMARY_HOUR=21

# (Optional) Name of a Telegram folder of the user client account: its channels are
# monitored for that account as if added with /add_channel (the account must /start the bot)
# CHANNEL_FOLDER=

# (Optional) Override session file names
# BOT_SESSION_NAME=bot_session
# CLIENT_SESSION_NAME=client_session

# (Optional) Override database URL
# DATABASE_URL=sqlite:///data/db.sqlite3
